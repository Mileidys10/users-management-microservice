          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"0001\",\n  \"name\": \"El Profe\",\n  \"email\": \"arrietajohn@gmail.com\",\n  \"role\": \"ADMIN\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/0001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "0001"
          ]
        },
        "description": "Actualiza la información del usuario y su estado a ACTIVE."
