          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/0001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "0001"
          ]
        },
        "description": "Obtiene la información de un usuario dado su ID."
      },
      "response": []
    },
    {
