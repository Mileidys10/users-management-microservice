        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"0001\",\n  \"name\": \"El Profe\",\n  \"email\": \"arrietajohn@gmail.com\",\n  \"password\": \"Abcde1234567**\",\n  \"role\": \"ADMIN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "description": "Crea un nuevo usuario en estado PENDING y dispara la notificación de bienvenida asíncrona."
      },
      "response": []
    },
    {
      "name": "Usuarios - Obtener Usuario por ID",
      "request": {
        "method": "GET",
        "header": [
          {
